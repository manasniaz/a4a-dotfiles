# Generated from the wallpaper by matugen. Do not edit: rewritten on every
# wallpaper change. btop.conf names it (color_theme = "a4a").

theme[main_bg]="{{colors.background.dark.hex}}"
theme[main_fg]="{{colors.on_surface.dark.hex}}"
theme[title]="{{colors.on_surface.dark.hex}}"
theme[hi_fg]="{{colors.primary.dark.hex}}"
theme[selected_bg]="{{colors.surface_container_high.dark.hex}}"
theme[selected_fg]="{{colors.primary.dark.hex}}"
theme[inactive_fg]="{{colors.outline.dark.hex}}"
theme[proc_misc]="{{colors.tertiary.dark.hex}}"
theme[cpu_box]="{{colors.primary.dark.hex}}"
theme[mem_box]="{{colors.tertiary.dark.hex}}"
theme[net_box]="{{colors.secondary.dark.hex}}"
theme[proc_box]="{{colors.primary_container.dark.hex}}"
theme[div_line]="{{colors.outline_variant.dark.hex}}"
theme[temp_start]="{{colors.primary_container.dark.hex}}"
theme[temp_mid]="{{colors.primary.dark.hex}}"
theme[temp_end]="{{colors.error.dark.hex}}"
theme[cpu_start]="{{colors.primary_container.dark.hex}}"
theme[cpu_mid]="{{colors.primary.dark.hex}}"
theme[cpu_end]="{{colors.tertiary.dark.hex}}"
theme[free_start]="{{colors.tertiary.dark.hex}}"
theme[free_mid]="{{colors.tertiary_container.dark.hex}}"
theme[free_end]="{{colors.on_surface.dark.hex}}"
theme[cached_start]="{{colors.primary_container.dark.hex}}"
theme[cached_mid]="{{colors.primary.dark.hex}}"
theme[cached_end]="{{colors.on_surface.dark.hex}}"
theme[available_start]="{{colors.secondary.dark.hex}}"
theme[available_mid]="{{colors.secondary.dark.hex}}"
theme[available_end]="{{colors.on_surface.dark.hex}}"
theme[used_start]="{{colors.primary.dark.hex}}"
theme[used_mid]="{{colors.tertiary.dark.hex}}"
theme[used_end]="{{colors.error.dark.hex}}"
theme[download_start]="{{colors.primary_container.dark.hex}}"
