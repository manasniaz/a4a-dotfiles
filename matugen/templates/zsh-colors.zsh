# Generated from the wallpaper by matugen. Do not edit: rewritten on every
# wallpaper change. Sourced by zsh/.zshrc after the plugins, so the styles apply.

# Autosuggestions: the ghost text is muted, so it reads as a hint, not as input.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg={{colors.outline.dark.hex}}"

# Syntax highlighting: what you type is coloured by what it is.
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]="fg={{colors.primary.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[builtin]="fg={{colors.primary.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[alias]="fg={{colors.primary.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[function]="fg={{colors.primary.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[unknown-token]="fg={{colors.error.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[reserved-word]="fg={{colors.secondary.dark.hex}},bold"
ZSH_HIGHLIGHT_STYLES[path]="fg={{colors.on_surface.dark.hex}},underline"
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]="fg={{colors.tertiary.dark.hex}}"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]="fg={{colors.tertiary.dark.hex}}"
ZSH_HIGHLIGHT_STYLES[option]="fg={{colors.secondary.dark.hex}}"
ZSH_HIGHLIGHT_STYLES[comment]="fg={{colors.outline.dark.hex}}"
