#!/usr/bin/env bash
# Copies the login screen's files into /etc/greetd: the config, the palette stylesheet
# and the current wallpaper. Run it after changing the wallpaper, then restart greetd.
# It doesn't enable greetd: that is a separate, deliberate step (see system/README.md).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE="$HOME/.cache/a4a"

[[ -f "$CACHE/gtkgreet.css" && -f "$CACHE/lock.jpg" ]] || {
    echo "a4a-greeter: run a4a-wallpaper first (it makes the palette and the wallpaper)." >&2
    exit 1
}

sudo install -d -m755 /etc/greetd
sudo install -m644 "$REPO/system/greetd/config.toml" /etc/greetd/config.toml
sudo install -m644 "$CACHE/gtkgreet.css" /etc/greetd/gtkgreet.css
# The greeter's config names wallpaper.png, so the lock screen's JPEG is converted
# rather than the login config changed.
tmp="$(mktemp --suffix=.png)"
ffmpeg -loglevel error -nostdin -y -i "$CACHE/lock.jpg" -frames:v 1 "$tmp"
sudo install -m644 "$tmp" /etc/greetd/wallpaper.png
rm -f "$tmp"
echo "a4a-greeter: installed. Enable it with: see system/README.md"
